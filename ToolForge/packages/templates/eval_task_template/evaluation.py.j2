def evaluate(workspace_path: str | None = None) -> dict:
    """Return {'pass': bool, 'score': float, 'details': str}"""
    ws = Path(workspace_path or os.environ.get("AGENT_WORKSPACE", "."))

    results = []
    {% for case in spec.eval.cases %}
    # Case: {{ case.id }}
    # {{ case.description }}
    # Expected: {{ case.expected_output | tojson }}
    results.append({"case": "{{ case.id }}", "pass": False, "detail": "not evaluated"})
    {% endfor %}

    passed = sum(1 for r in results if r["pass"])
    total = len(results) or 1
    score = passed / total
    all_pass = score >= {{ spec.eval.baseline_pass_rate }}

    return {
        "pass": all_pass,
        "score": round(score, 4),
        "passed": passed,
        "total": total,
        "baseline": {{ spec.eval.baseline_pass_rate }},
        "details": results,
    }


