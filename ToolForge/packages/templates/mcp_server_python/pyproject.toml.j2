[project]
name = "{{ spec.slug }}"
version = "{{ spec.version }}"
description = "{{ spec.description }}"
requires-python = ">=3.12"
dependencies = [
    "mcp>=1.10.1",
    {% for dep in spec.dependencies %}
    "{{ dep }}",
    {% endfor %}
]

[project.scripts]
{{ spec.slug }}-server = "server:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
