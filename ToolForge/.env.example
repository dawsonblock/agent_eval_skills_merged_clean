# ToolForge Environment Variables
# Copy this to .env and fill in values. NEVER commit .env to version control.

# === Optional: LLM providers for spec-from-prompt ===
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LOCAL_MODEL_URL=http://localhost:11434/v1

# === Optional: Local DeepSeek Tool UI Demo ===
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# === Optional: Toolathlon integration ===
# TOOLATHLON_PG_HOST=localhost
# TOOLATHLON_PG_PORT=5432
# TOOLATHLON_PG_USER=postgres
# TOOLATHLON_PG_PASSWORD=...
# TOOLATHLON_PG_DB=toolathlon

# === Optional: Docker sandbox ===
# TOOLFORGE_DOCKER_IMAGE=toolforge-sandbox:latest

# === Sandbox behavior ===
# TOOLFORGE_SANDBOX_LEVEL=2
# TOOLFORGE_EXECUTION_TIMEOUT=60
