{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillforge.local/schemas/skill_schema.json",
  "title": "SkillForge Skill Metadata",
  "type": "object",
  "required": [
    "name",
    "description",
    "category",
    "version",
    "inputs",
    "outputs",
    "tools_required",
    "mcp_servers",
    "permissions",
    "risk_level",
    "validation"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "data",
        "documents",
        "coding",
        "browser",
        "automation",
        "media",
        "3d",
        "game-dev",
        "robotics",
        "hardware",
        "research",
        "productivity",
        "custom"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "tools_required": {
      "type": "array",
      "items": {"type": "string"}
    },
    "mcp_servers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read_files",
          "write_files",
          "run_validators",
          "run_tests",
          "package_skills",
          "network_access",
          "shell_commands",
          "docker_access",
          "external_api",
          "hardware_access",
          "read_secrets"
        ]
      }
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "validation": {
      "type": "object",
      "required": ["metadata", "syntax", "tests", "package", "smoke"],
      "additionalProperties": false,
      "properties": {
        "metadata": {"type": "string", "enum": ["pending", "passed", "failed", "skipped"]},
        "syntax": {"type": "string", "enum": ["pending", "passed", "failed", "skipped"]},
        "tests": {"type": "string", "enum": ["pending", "passed", "failed", "skipped"]},
        "package": {"type": "string", "enum": ["pending", "passed", "failed", "skipped"]},
        "smoke": {"type": "string", "enum": ["pending", "passed", "failed", "skipped"]}
      }
    }
  }
}
