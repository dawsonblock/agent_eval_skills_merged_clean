{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillforge.local/schemas/permission_schema.json",
  "title": "SkillForge Permission State",
  "type": "object",
  "required": ["version", "default_mode", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "default_mode": {
      "type": "string",
      "enum": ["interactive", "auto_approve", "strict"]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "tier"],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "enum": ["safe", "approval_required", "blocked"]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "approved", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "approved": {
            "type": "boolean"
          },
          "timestamp": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
